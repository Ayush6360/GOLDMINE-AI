# Phoenix web — environment config. Copy to .env.local and edit as needed.
# The app runs fully with ALL of these unset (keyless mode).

# Optional: FRED API key (free) → adds CPI, real yields, policy rate.
# Get one at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# SQLite database file path (default: phoenix.db in the app dir)
PHOENIX_DB_PATH=phoenix.db

# Master data switch: "true" = live sources + SQLite, "false" = pure seed data
PHOENIX_LIVE_DATA=true

# Network timeout for source fetches, ms
PHOENIX_FETCH_TIMEOUT_MS=12000

# Optional: shared secret to protect /api/ingest (set the x-ingest-secret header)
PHOENIX_INGEST_SECRET=

# Optional: Anthropic API key for the Ask Phoenix assistant.
# IMPORTANT: leaving this set does NOTHING by itself — Claude is OFF by default.
# The assistant uses the free, keyless grounded composer ($0) unless you ALSO set
# PHOENIX_USE_CLAUDE=true below. This prevents surprise API bills.
ANTHROPIC_API_KEY=

# Set to "true" ONLY if you want the assistant to call paid Claude (costs money,
# ~$0.01-0.03 per question). Default "false" = free keyless answers, equally honest.
PHOENIX_USE_CLAUDE=false
